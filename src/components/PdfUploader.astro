---
import { MAX_FILE_SIZE_MB } from "../lib/config";

const MAX_FILE_SIZE_MB_LITERAL = MAX_FILE_SIZE_MB;
---

<section id="pdf-uploader" class="space-y-6" data-max-size-mb={MAX_FILE_SIZE_MB_LITERAL}>
	<div
		id="dropzone"
		class="relative cursor-pointer rounded-2xl border-2 border-dashed border-stone-300 bg-white p-10 text-center transition hover:border-amber-500/70 hover:bg-amber-50"
	>
		<input
			id="file-input"
			type="file"
			accept=".pdf,application/pdf"
			class="sr-only"
		/>
		<div id="dropzone-content">
			<p class="text-4xl" aria-hidden="true">📖</p>
			<p class="mt-3 font-medium">Arrastra tu PDF aquí</p>
			<p class="mt-1 text-sm text-stone-500">o haz clic para elegir un archivo</p>
			<p class="mt-4 text-xs text-stone-400">
				Solo PDF &middot; máx. {MAX_FILE_SIZE_MB_LITERAL} MB
			</p>
		</div>

		<div id="uploading" class="hidden py-4">
			<p id="upload-status" class="text-sm font-medium text-amber-700">Subiendo el archivo…</p>
			<div class="mx-auto mt-4 h-1.5 w-56 overflow-hidden rounded-full bg-stone-200">
				<div
					id="progress-bar"
					class="h-full rounded-full bg-amber-500 transition-all duration-500"
					style="width: 0%"
				></div>
			</div>
			<p class="mt-3 text-xs text-stone-500">Esto puede tardar hasta un minuto.</p>
		</div>
	</div>

	<div id="error-alert" class="hidden rounded-lg border border-red-300 bg-red-50 px-4 py-3 text-sm text-red-700" role="alert"></div>

	<article id="result" class="hidden space-y-6" hidden>
		<header class="flex flex-wrap items-center justify-between gap-2 border-b border-stone-200 pb-4">
			<div>
				<p id="result-filename" class="font-semibold"></p>
				<p id="result-meta" class="text-xs text-stone-500"></p>
			</div>
			<span class="rounded-full border border-amber-300 bg-amber-50 px-3 py-1 text-xs text-amber-700">
				Crítica generada
			</span>
		</header>
		<div id="result-body" class="prose prose-stone max-w-none prose-headings:mt-8 prose-headings:mb-3 prose-headings:text-amber-700 prose-p:leading-relaxed prose-strong:text-stone-900 prose-li:marker:text-amber-600"></div>
		<div class="flex justify-end">
			<button
				id="new-critique"
				type="button"
				class="rounded-lg border border-stone-300 px-4 py-2 text-sm text-stone-700 transition hover:border-amber-500 hover:text-amber-700"
			>
				Criticar otro libro
			</button>
		</div>
	</article>
</section>

<script>
	import { renderMarkdown, truncateFileName } from "../lib/markdown";

	const root = document.getElementById("pdf-uploader") as HTMLElement;
	const maxSizeMb = Number(root.dataset.maxSizeMb);

	const dropzone = document.getElementById("dropzone") as HTMLElement;
	const dropzoneContent = document.getElementById("dropzone-content") as HTMLElement;
	const fileInput = document.getElementById("file-input") as HTMLInputElement;
	const uploading = document.getElementById("uploading") as HTMLElement;
	const uploadStatus = document.getElementById("upload-status") as HTMLElement;
	const progressBar = document.getElementById("progress-bar") as HTMLElement;
	const errorAlert = document.getElementById("error-alert") as HTMLElement;
	const result = document.getElementById("result") as HTMLElement;
	const resultFilename = document.getElementById("result-filename") as HTMLElement;
	const resultMeta = document.getElementById("result-meta") as HTMLElement;
	const resultBody = document.getElementById("result-body") as HTMLElement;
	const newCritiqueButton = document.getElementById("new-critique") as HTMLButtonElement;

	interface Stage {
		label: string;
		percent: number;
	}

	const STAGES: Record<string, Stage> = {
		uploading: { label: "Subiendo el archivo…", percent: 15 },
		extracting: { label: "Extrayendo el texto del PDF…", percent: 45 },
		critiquing: { label: "Pidiendo la crítica a la IA…", percent: 80 },
		cached: { label: "Recuperando la crítica guardada…", percent: 90 },
	};

	function setStage(name: string) {
		const stage = STAGES[name];
		if (!stage) return;
		uploadStatus.textContent = stage.label;
		progressBar.style.width = `${stage.percent}%`;
	}

	function setBusy(busy: boolean) {
		dropzone.classList.toggle("pointer-events-none", busy);
		dropzoneContent.classList.toggle("hidden", busy);
		uploading.classList.toggle("hidden", !busy);
		if (!busy) {
			uploadStatus.textContent = "";
			progressBar.style.width = "0%";
		}
	}

	function showError(message: string) {
		errorAlert.textContent = message;
		errorAlert.classList.remove("hidden");
	}

	function hideError() {
		errorAlert.classList.add("hidden");
		errorAlert.textContent = "";
	}

	function reset() {
		hideError();
		result.classList.add("hidden");
		result.setAttribute("hidden", "");
		fileInput.value = "";
	}

	dropzone.addEventListener("click", () => fileInput.click());

	for (const eventName of ["dragover", "dragenter"]) {
		dropzone.addEventListener(eventName, (event) => {
			event.preventDefault();
			dropzone.classList.add("border-amber-500");
		});
	}

	for (const eventName of ["dragleave", "drop"]) {
		dropzone.addEventListener(eventName, (event) => {
			event.preventDefault();
			dropzone.classList.remove("border-amber-500");
		});
	}

	dropzone.addEventListener("drop", (event) => {
		const file = event.dataTransfer?.files?.[0];
		if (file) submitFile(file);
	});

	fileInput.addEventListener("change", () => {
		const file = fileInput.files?.[0];
		if (file) submitFile(file);
	});

	newCritiqueButton.addEventListener("click", reset);

	async function submitFile(file: File) {
		hideError();
		reset();

		if (file.type !== "application/pdf" && !file.name.toLowerCase().endsWith(".pdf")) {
			showError("Solo se permiten archivos PDF.");
			return;
		}

		if (file.size > maxSizeMb * 1024 * 1024) {
			showError(`El archivo supera el límite de ${maxSizeMb} MB.`);
			return;
		}

		const formData = new FormData();
		formData.append("file", file);

		setBusy(true);
		try {
			const response = await fetch("/api/critique", {
				method: "POST",
				body: formData,
			});

			if (!response.ok) {
				const payload = await response
					.json()
					.catch(() => null) as { error?: string } | null;
				throw new Error(payload?.error ?? `El servidor respondió con el estado ${response.status}.`);
			}

			if (!response.body) {
				throw new Error("Tu navegador no soporta respuestas en streaming.");
			}

			const reader = response.body.getReader();
			const decoder = new TextDecoder();
			let buffer = "";
			let result: CritiqueResult | null = null;

			while (true) {
				const { done, value } = await reader.read();
				if (done) break;

				buffer += decoder.decode(value, { stream: true });
				const lines = buffer.split("\n");
				buffer = lines.pop() ?? "";

				for (const line of lines) {
					if (!line.trim()) continue;

					const message = JSON.parse(line) as {
						event: string;
						error?: string;
						result?: CritiqueResult;
					};

					if (message.event === "error") {
						throw new Error(message.error ?? "Ocurrió un error inesperado.");
					}

					if (message.event === "done" && message.result) {
						result = message.result;
						uploadStatus.textContent = "Crítica lista";
						progressBar.style.width = "100%";
						continue;
					}

					setStage(message.event);
				}

				if (result) break;
			}

			if (!result) {
				throw new Error("El servidor no devolvió una crítica.");
			}

			renderResult(result);
		} catch (error) {
			showError(
				error instanceof Error
					? error.message
					: "Ocurrió un error inesperado.",
			);
		} finally {
			setBusy(false);
		}
	}

	interface CritiqueResult {
		fileName: string;
		pageCount: number;
		critique: string;
		model: string;
		cached?: boolean;
	}

	function renderResult(payload: CritiqueResult) {
		resultFilename.textContent = truncateFileName(payload.fileName);
		const cacheTag = payload.cached ? " · respuesta en caché" : "";
		resultMeta.textContent = `${payload.pageCount} página${payload.pageCount === 1 ? "" : "s"} · modelo ${payload.model}${cacheTag}`;
		resultBody.innerHTML = renderMarkdown(payload.critique);
		result.classList.remove("hidden");
		result.removeAttribute("hidden");
		window.scrollTo({ top: result.offsetTop - 80, behavior: "smooth" });
	}
</script>